          "options": [
            {
              "id": "purchasing",
              "label": "Purchasing"
            },
            {
              "id": "accounts_payable",
              "label": "Accounts payable"
            },
            {
              "id": "sales",
              "label": "Sales"
            },
            {
              "id": "customer_service",
              "label": "Customer service"
            },
            {
              "id": "production_control",
              "label": "Production control"
            },
            {
              "id": "manufacturing",
              "label": "Manufacturing"
            },
            {
              "id": "engineering",
              "label": "Engineering"
            },
            {
              "id": "quality",
              "label": "Quality"
            },
            {
              "id": "logistics",
              "label": "Logistics"
            },
            {
              "id": "hr",
              "label": "Hr"
            },
            {
              "id": "finance",
              "label": "Finance"
            }
          ]
        },
        {
          "id": "identity.company",
          "label": "Company",
          "options": [
            {
              "id": "BMC",
              "label": "BMC"
            },
            {
              "id": "BME",
              "label": "BME"
            },
            {
              "id": "MAI",
              "label": "MAI"
            }
          ]
        },
        {
          "id": "identity.environment",
          "label": "Environment",
          "options": [
            {
              "id": "TEST",
              "label": "TEST"
            },
            {
              "id": "PROD",
              "label": "PROD"
