  "rules": [
    {
      "id": "reason-model",
      "when": {
        "capability": [
          "REASON"
        ]
      },
      "checks": [
        {
          "field": "execute.model_access",
          "not_in": [
            "off",
            null
          ]
        }
      ],
      "step": "execute",
      "message": "An Analyst needs model assistance chosen by you.",
      "blocks_publish": true
    },
    {
      "id": "class-review",
      "when": {
        "capability": [
          "CLASS"
        ]
      },
      "checks": [
        {
          "field": "output.outcomes",
          "in": [
            "completed_review",
            "full_set"
          ]
        }
      ],
      "step": "output",
      "message": "A Classifier must be able to return UNKNOWN or needs review.",
      "blocks_publish": true
    },
    {
      "id": "read-authority",
      "when": {
        "capability": [
          "READ"
        ]
      },
      "checks": [
        {
          "field": "execute.authority",
          "in": [
            "P1",
            "P2"
          ]
        }
      ],
      "step": "execute",
      "message": "A Data Retriever needs approved read access.",
      "blocks_publish": true
    },
    {
      "id": "comms-authority",
      "when": {
        "capability": [
          "COMMS"
        ]
      },
      "checks": [
        {
          "field": "execute.authority",
          "in": [
            "P4"
          ]
        }
      ],
      "step": "execute",
      "message": "A Messenger needs authorized communication access.",
      "blocks_publish": true
    },
    {
      "id": "write-authority",
      "when": {
        "capability": [
          "WRITE"
        ]
      },
      "checks": [
        {
          "field": "execute.authority",
          "in": [
            "P5"
          ]
        }
      ],
      "step": "execute",
      "message": "A Transaction Writer needs specifically authorized transaction access.",
      "blocks_publish": true
    },
    {
      "id": "external-approval",
      "when": {
        "capability": [
          "COMMS",
          "WRITE"
        ]
      },
      "checks": [
        {
          "field": "verify.approval_gate",
          "in": [
            "single_approver",
            "two_approvers"
          ]
        }
      ],
      "step": "verify",
      "message": "Choose a human approval gate for this external action.",
      "blocks_publish": true
    },
    {
      "id": "write-readback",
      "when": {
        "capability": [
          "WRITE"
        ]
      },
      "checks": [
        {
          "field": "verify.postcondition",
          "in": [
            "target_readback"
          ]
        }
      ],
      "step": "verify",
      "message": "Verify a transaction by reading the target back.",
      "blocks_publish": true
    },
    {
      "id": "write-reconcile",
      "when": {
        "capability": [
          "WRITE"
        ]
      },
      "checks": [
        {
          "field": "error.ambiguous_external",
          "in": [
            "suspend_and_reconcile"
          ]
        }
      ],
      "step": "error",
      "message": "An uncertain transaction must pause and reconcile before retry.",
      "blocks_publish": true
    },
    {
      "id": "model-budget",
      "when": {
        "field": "execute.model_access",
        "not_in": [
          "off",
