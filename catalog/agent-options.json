{
  "version": "1.0.0",
  "guide_version": "1.0.0",
  "capabilities": [
    {
      "code": "DOC",
      "title": "Document Reader",
      "description": "Turns a PDF, image or attachment into text and fields with page evidence",
      "color": "#64748B"
    },
    {
      "code": "READ",
      "title": "Data Retriever",
      "description": "Pulls exact records from Epicor, Graph, SharePoint or Operis",
      "color": "#0284C7"
    },
    {
      "code": "MAP",
      "title": "Field Mapper",
      "description": "Reshapes one record format into another",
      "color": "#0891B2"
    },
    {
      "code": "RULE",
      "title": "Rule Checker",
      "description": "Applies an approved rule or comparison and returns pass, fail or review",
      "color": "#7C3AED"
    },
    {
      "code": "CLASS",
      "title": "Classifier",
      "description": "Sorts an item into one class from a fixed list, or UNKNOWN",
      "color": "#0D9488"
    },
    {
      "code": "ROUTE",
      "title": "Router",
      "description": "Decides which workflow or queue a record goes to next",
      "color": "#D97706"
    },
    {
      "code": "COMMS",
      "title": "Messenger",
      "description": "Drafts or sends an email, Teams message or alert",
      "color": "#DB2777"
    },
    {
      "code": "WRITE",
      "title": "Transaction Writer",
      "description": "Creates or updates a record in a business system",
      "color": "#DC2626"
    },
    {
      "code": "REASON",
      "title": "Analyst",
      "description": "Bounded model reasoning over supplied evidence",
      "color": "#6D28D9"
    }
  ],
  "locked": [
    "identity.owner",
    "identity.environment",
    "execute.authority"
  ],
  "conditional_locked": [
    {
      "field": "execute.model_access",
      "unless_value": "off"
    },
    {
      "field": "verify.approval_gate",
      "capabilities": [
        "COMMS",
        "WRITE"
      ]
    }
  ],
  "outcomes": {
    "completed_only": [
      "COMPLETED"
    ],
    "completed_no_action": [
      "COMPLETED",
      "NO_ACTION"
    ],
    "completed_review": [
      "COMPLETED",
      "REVIEW_REQUIRED"
    ],
    "full_set": [
      "COMPLETED",
      "NO_ACTION",
      "REVIEW_REQUIRED",
      "REJECTED",
      "FAILED_FINAL"
    ]
  },
  "steps": [
