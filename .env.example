# Load through a launcher or secret manager; Uvicorn does not load this file automatically.
FLUX_FRESH=1
STUDIO_PUBLIC_HOST=localhost
STUDIO_DEPLOYMENT_ID=local-development
STUDIO_DRAFT_ENABLED=false
ANTHROPIC_API_KEY=
STUDIO_DRAFT_MODEL=claude-sonnet-4-6
STUDIO_DRAFT_INPUT_PER_MTOK=0
STUDIO_DRAFT_OUTPUT_PER_MTOK=0
STUDIO_DRAFT_COST_CEILING=0.25

# Fixture model evaluation remains disabled unless explicitly enabled.
# Also requires verified prices above and an explicit max_cost_usd per suite call.
STUDIO_FIXTURE_MODELS_ENABLED=false
